# Supabase > Project Settings > API. Esta clave es pública y está protegida por RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternativa compatible: NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sólo para scripts locales. Nunca usar NEXT_PUBLIC_ con esta variable.
SUPABASE_SERVICE_ROLE_KEY=
# Definir contraseñas propias antes de ejecutar npm run seed:users (mín. 12 caracteres).
DEMO_CLIENT_PASSWORD=
DEMO_ADMIN_PASSWORD=

# Opcional: demo local explícita en producción SIN Supabase. Nunca contiene datos reales.
# En desarrollo se habilita automáticamente si no hay configuración Supabase.
ENABLE_LOCAL_DEMO=false
